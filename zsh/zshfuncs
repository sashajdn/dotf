# _unit_worktrees: List worktree tickets as relative paths from the agents dir.
# Finds actual worktrees (leaf nodes), not intermediate directories.
# Usage: _unit_worktrees <worktree_base_dir>
_unit_worktrees() {
    local base="$1"
    git worktree list --porcelain | while read -r line; do
        case "$line" in
            worktree\ *)
                local wt_path="${line#worktree }"
                if [[ "$wt_path" == "$base"/* ]]; then
                    echo "${wt_path#$base/}"
                fi
                ;;
        esac
    done
}

# unit-new: Create/open a worktree and tmux unit window
# Usage: unit-new <ticket-name> [branch-name]
unit-new() {
    command unit-open "$@"
}

# unit-cd: fzf picker to open a unit window
# Usage: unit-cd
unit-cd() {
    local DOTF_AGENTS_WORKTREE_DIR="${DOTF_AGENTS_WORKTREE_DIR:-.agents}"

    local GIT_COMMON_DIR=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)
    if [[ -z "$GIT_COMMON_DIR" ]]; then
        echo "Error: Not in a git repository" >&2
        return 1
    fi

    local REPO_ROOT=$(dirname "$GIT_COMMON_DIR")
    local WORKTREE_BASE="$REPO_ROOT/$DOTF_AGENTS_WORKTREE_DIR"

    if [[ ! -d "$WORKTREE_BASE" ]]; then
        echo "No worktrees found. Use 'unit-new <ticket>' to create one." >&2
        return 1
    fi

    local tickets=("${(@f)$(_unit_worktrees "$WORKTREE_BASE")}")
    if [[ ${#tickets[@]} -eq 0 ]] || [[ -z "${tickets[1]}" ]]; then
        echo "No worktrees found. Use 'unit-new <ticket>' to create one." >&2
        return 1
    fi

    local selected=$(printf '%s\n' "${tickets[@]}" | fzf --height 40% --reverse --border --header "Select worktree")

    if [[ -z "$selected" ]]; then
        return 0
    fi

    command unit-open "$selected"
}

# _unit_rm_one: Remove a single worktree by ticket name.
# Returns 0 on success, 1 if the user aborts a safety prompt or the path is missing.
# Args: ticket main_repo worktree_base auto_delete current_path
_unit_rm_one() {
    local TICKET="$1"
    local MAIN_REPO="$2"
    local WORKTREE_BASE="$3"
    local AUTO_DELETE="$4"
    local CURRENT_PATH="$5"
    local WORKTREE_PATH="$WORKTREE_BASE/$TICKET"

    if [[ ! -d "$WORKTREE_PATH" ]]; then
        echo "  Skipped: worktree path missing ($WORKTREE_PATH)"
        return 1
    fi

    local HAS_CHANGES=$(git -C "$WORKTREE_PATH" status --porcelain 2>/dev/null)
    if [[ -n "$HAS_CHANGES" ]]; then
        echo "  Warning: uncommitted changes"
        git -C "$WORKTREE_PATH" status --short | sed 's/^/    /'
        echo -n "  Continue anyway? [y/N] "
        read -r REPLY
        if [[ ! $REPLY =~ ^[Yy]$ ]]; then
            echo "  Skipped"
            return 1
        fi
    fi

    local BRANCH=$(git -C "$WORKTREE_PATH" rev-parse --abbrev-ref HEAD 2>/dev/null || true)
    if [[ -n "$BRANCH" ]] && [[ "$BRANCH" != "HEAD" ]]; then
        local UNPUSHED=$(git -C "$WORKTREE_PATH" log --oneline "@{upstream}..HEAD" 2>/dev/null)
        if [[ -n "$UNPUSHED" ]]; then
            echo "  Warning: unpushed commits"
            echo "$UNPUSHED" | sed 's/^/    /'
            echo -n "  Continue anyway? [y/N] "
            read -r REPLY
            if [[ ! $REPLY =~ ^[Yy]$ ]]; then
                echo "  Skipped"
                return 1
            fi
        fi
    fi

    if [[ "$CURRENT_PATH" == "$WORKTREE_PATH"* ]]; then
        cd "$MAIN_REPO"
        echo "  Moved to: $MAIN_REPO"
    fi

    git worktree remove "$WORKTREE_PATH" --force

    if [[ -n "$BRANCH" ]] && [[ "$BRANCH" != "HEAD" ]]; then
        if [[ "$AUTO_DELETE" == "yes" ]]; then
            git -C "$MAIN_REPO" branch -d "$BRANCH" 2>/dev/null || git -C "$MAIN_REPO" branch -D "$BRANCH"
            echo "  Branch $BRANCH deleted"
        elif [[ "$AUTO_DELETE" == "no" ]]; then
            echo "  Branch $BRANCH kept"
        else
            echo -n "  Delete branch '$BRANCH'? [y/N] "
            read -r REPLY
            if [[ $REPLY =~ ^[Yy]$ ]]; then
                git -C "$MAIN_REPO" branch -d "$BRANCH" 2>/dev/null || git -C "$MAIN_REPO" branch -D "$BRANCH"
                echo "  Branch $BRANCH deleted"
            fi
        fi
    fi

    local REPO_NAME=$(basename "$MAIN_REPO" | tr '[:upper:]' '[:lower:]' | tr -cs '[:alnum:]-' '-' | sed 's/^-//;s/-$//')
    tmux-unit-close --session "$REPO_NAME" --ticket "$TICKET" --path "$WORKTREE_PATH" 2>/dev/null || true

    echo "  Worktree $TICKET removed"
    return 0
}

# unit-rm: fzf picker to remove a worktree (or current if in one).
# Usage: unit-rm [-y] [--all]
#   -y      Auto-confirm branch deletion
#   --all   Iterate every worktree and prompt y/N/q per ticket
unit-rm() {
    local DOTF_AGENTS_WORKTREE_DIR="${DOTF_AGENTS_WORKTREE_DIR:-.agents}"
    local AUTO_DELETE=""
    local ALL=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -y) AUTO_DELETE="yes"; shift ;;
            --all) ALL="yes"; shift ;;
            *) shift ;;
        esac
    done

    local CURRENT_PATH=$(pwd)
    local WORKTREE_PATH=""
    local TICKET=""
    local MAIN_REPO=""

    local GIT_COMMON_DIR=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)
    if [[ -z "$GIT_COMMON_DIR" ]]; then
        echo "Error: Not in a git repository" >&2
        return 1
    fi

    MAIN_REPO=$(dirname "$GIT_COMMON_DIR")

    local REPO_NAME=$(basename "$MAIN_REPO" | tr '[:upper:]' '[:lower:]' | tr -cs '[:alnum:]-' '-' | sed 's/^-//;s/-$//')
    local WORKTREE_BASE="$MAIN_REPO/$DOTF_AGENTS_WORKTREE_DIR"

    if [[ -n "$ALL" ]]; then
        if [[ ! -d "$WORKTREE_BASE" ]]; then
            echo "No worktrees found." >&2
            return 1
        fi

        local tickets=("${(@f)$(_unit_worktrees "$WORKTREE_BASE")}")
        if [[ ${#tickets[@]} -eq 0 ]] || [[ -z "${tickets[1]}" ]]; then
            echo "No worktrees found." >&2
            return 1
        fi

        echo "Found ${#tickets[@]} worktree(s) under $WORKTREE_BASE"
        echo "Per worktree: y=remove, n=skip, q=quit"

        local removed=0
        local skipped=0
        for ticket in "${tickets[@]}"; do
            [[ -z "$ticket" ]] && continue
            local wt="$WORKTREE_BASE/$ticket"
            local branch=$(git -C "$wt" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "?")
            local dirty=""
            [[ -n $(git -C "$wt" status --porcelain 2>/dev/null) ]] && dirty=" [dirty]"

            echo ""
            echo "──── $ticket (${branch})${dirty} ────"
            echo -n "Remove? [y/N/q] "
            read -r REPLY
            case "$REPLY" in
                [Yy])
                    if _unit_rm_one "$ticket" "$MAIN_REPO" "$WORKTREE_BASE" "$AUTO_DELETE" "$CURRENT_PATH"; then
                        removed=$((removed + 1))
                    else
                        skipped=$((skipped + 1))
                    fi
                    ;;
                [Qq])
                    echo "Stopping."
                    break
                    ;;
                *)
                    echo "  Skipped"
                    skipped=$((skipped + 1))
                    ;;
            esac
        done

        echo ""
        echo "Done. Removed: $removed, skipped: $skipped"
        return 0
    fi

    if [[ "$CURRENT_PATH" == *"/$DOTF_AGENTS_WORKTREE_DIR/"* ]]; then
        WORKTREE_PATH=$(git rev-parse --show-toplevel 2>/dev/null)
        TICKET="${WORKTREE_PATH#$WORKTREE_BASE/}"
        echo "Currently in worktree: $TICKET"
    else
        if [[ ! -d "$WORKTREE_BASE" ]]; then
            echo "No worktrees found." >&2
            return 1
        fi

        local tickets=("${(@f)$(_unit_worktrees "$WORKTREE_BASE")}")
        if [[ ${#tickets[@]} -eq 0 ]] || [[ -z "${tickets[1]}" ]]; then
            echo "No worktrees found." >&2
            return 1
        fi

        TICKET=$(printf '%s\n' "${tickets[@]}" | fzf --height 40% --reverse --border --header "Select worktree to remove")

        if [[ -z "$TICKET" ]]; then
            return 0
        fi

        WORKTREE_PATH="$WORKTREE_BASE/$TICKET"
    fi

    echo "Removing worktree: $TICKET"
    echo "  Path: $WORKTREE_PATH"
    _unit_rm_one "$TICKET" "$MAIN_REPO" "$WORKTREE_BASE" "$AUTO_DELETE" "$CURRENT_PATH" || return 1

}

# unit-rust-clean: Iterate worktrees and run `cargo clean` per consent.
# Usage: unit-rust-clean
#   Per worktree: y=clean, n=skip, q=quit
unit-rust-clean() {
    local DOTF_AGENTS_WORKTREE_DIR="${DOTF_AGENTS_WORKTREE_DIR:-.agents}"

    if ! command -v cargo >/dev/null 2>&1; then
        echo "Error: cargo not found in PATH" >&2
        return 1
    fi

    local GIT_COMMON_DIR=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)
    if [[ -z "$GIT_COMMON_DIR" ]]; then
        echo "Error: Not in a git repository" >&2
        return 1
    fi

    local MAIN_REPO
    MAIN_REPO=$(dirname "$GIT_COMMON_DIR")

    local WORKTREE_BASE="$MAIN_REPO/$DOTF_AGENTS_WORKTREE_DIR"

    if [[ ! -d "$WORKTREE_BASE" ]]; then
        echo "No worktrees found." >&2
        return 1
    fi

    local tickets=("${(@f)$(_unit_worktrees "$WORKTREE_BASE")}")
    if [[ ${#tickets[@]} -eq 0 ]] || [[ -z "${tickets[1]}" ]]; then
        echo "No worktrees found." >&2
        return 1
    fi

    echo "Found ${#tickets[@]} worktree(s) under $WORKTREE_BASE"
    echo "Per worktree: y=cargo clean, n=skip, q=quit"

    local cleaned=0
    local skipped=0
    for ticket in "${tickets[@]}"; do
        [[ -z "$ticket" ]] && continue
        local wt="$WORKTREE_BASE/$ticket"

        echo ""
        echo "──── $ticket ────"

        if [[ ! -f "$wt/Cargo.toml" ]]; then
            echo "  No Cargo.toml at root, skipping"
            skipped=$((skipped + 1))
            continue
        fi

        local size="(none)"
        if [[ -d "$wt/target" ]]; then
            size=$(du -sh "$wt/target" 2>/dev/null | cut -f1)
        fi
        echo "  target/: $size"

        echo -n "  Run 'cargo clean'? [y/N/q] "
        read -r REPLY
        case "$REPLY" in
            [Yy])
                if (cd "$wt" && cargo clean); then
                    echo "  Cleaned"
                    cleaned=$((cleaned + 1))
                else
                    echo "  cargo clean failed"
                    skipped=$((skipped + 1))
                fi
                ;;
            [Qq])
                echo "  Stopping."
                break
                ;;
            *)
                echo "  Skipped"
                skipped=$((skipped + 1))
                ;;
        esac
    done

    echo ""
    echo "Done. Cleaned: $cleaned, skipped: $skipped"
}
