#!/usr/bin/env bash
#
# tmux-unit-layout: apply the standard unit window layout.
#
# Usage:
#   tmux-unit-layout 3 --target <target> --cwd <path> --title-prefix <repo> [--ticket <ticket>] --force
#   tmux-unit-layout 1 --current --force

set -euo pipefail

MODE="${1:-}"
if [[ "$MODE" != "1" && "$MODE" != "3" ]]; then
    echo "Usage: tmux-unit-layout <1|3> [--current|--target <target>] [--cwd <path>] [--title-prefix <name>] [--ticket <ticket>] [--force]" >&2
    exit 1
fi
shift

TARGET=""
CWD=""
TITLE_PREFIX=""
TICKET=""
FORCE=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --current)
            TARGET="$(tmux display-message -p '#{window_id}')"
            CWD="${CWD:-$(tmux display-message -p '#{pane_current_path}')}"
            TITLE_PREFIX="${TITLE_PREFIX:-$(tmux display-message -p '#{session_name}')}"
            shift
            ;;
        --target)
            TARGET="$2"
            shift 2
            ;;
        --cwd)
            CWD="$2"
            shift 2
            ;;
        --title-prefix)
            TITLE_PREFIX="$2"
            shift 2
            ;;
        --ticket)
            TICKET="$2"
            shift 2
            ;;
        --force)
            FORCE="yes"
            shift
            ;;
        *)
            echo "Unknown argument: $1" >&2
            exit 1
            ;;
    esac
done

if [[ -z "$TARGET" ]]; then
    echo "Error: --target or --current is required" >&2
    exit 1
fi

CWD="${CWD:-$(tmux display-message -p -t "$TARGET" '#{pane_current_path}')}"
TITLE_PREFIX="${TITLE_PREFIX:-$(tmux display-message -p -t "$TARGET" '#{session_name}')}"

pane_count() {
    tmux list-panes -t "$TARGET" -F '#{pane_id}' | wc -l | tr -d ' '
}

find_main_pane() {
    local pane role
    while IFS=$'\t' read -r pane role; do
        if [[ "$role" == "main" ]]; then
            printf '%s\n' "$pane"
            return 0
        fi
    done < <(tmux list-panes -t "$TARGET" -F '#{pane_id}	#{@unit_role}')

    tmux list-panes -t "$TARGET" -F '#{pane_id}' | head -n 1
}

kill_sidecars() {
    local main_pane="$1"
    local count pane

    count="$(pane_count)"
    if [[ "$count" -gt 1 && -z "$FORCE" ]]; then
        echo "Error: target has $count panes; pass --force to replace the layout" >&2
        exit 1
    fi

    while read -r pane; do
        if [[ "$pane" != "$main_pane" ]]; then
            tmux kill-pane -t "$pane"
        fi
    done < <(tmux list-panes -t "$TARGET" -F '#{pane_id}')
}

clamp() {
    local value="$1"
    local min="$2"
    local max="$3"

    if (( value < min )); then
        value="$min"
    fi
    if (( value > max )); then
        value="$max"
    fi
    printf '%s\n' "$value"
}

role_title() {
    local role="$1"
    if [[ -n "$TICKET" ]]; then
        printf '%s:%s:%s\n' "$TITLE_PREFIX" "$role" "$TICKET"
    else
        printf '%s:%s\n' "$TITLE_PREFIX" "$role"
    fi
}

set_role() {
    local pane="$1"
    local role="$2"
    tmux set-option -p -t "$pane" -q @unit_role "$role"
    tmux select-pane -t "$pane" -T "$(role_title "$role")"
}

main_pane="$(find_main_pane)"
kill_sidecars "$main_pane"

set_role "$main_pane" "main"

if [[ "$MODE" == "1" ]]; then
    tmux select-pane -t "$main_pane"
    exit 0
fi

window_width="$(tmux display-message -p -t "$TARGET" '#{window_width}')"
window_height="$(tmux display-message -p -t "$TARGET" '#{window_height}')"
cell_width="$(tmux display-message -p -t "$TARGET" '#{window_cell_width}' 2>/dev/null || printf '0')"
cell_height="$(tmux display-message -p -t "$TARGET" '#{window_cell_height}' 2>/dev/null || printf '0')"

if [[ "$cell_width" =~ ^[1-9][0-9]*$ && "$cell_height" =~ ^[1-9][0-9]*$ ]]; then
    screen_width_px=$((window_width * cell_width))
    screen_height_px=$((window_height * cell_height))
    right_px="$(clamp $((screen_width_px * 24 / 100)) 396 616)"
    bottom_px="$(clamp $((screen_height_px * 22 / 100)) 145 290)"
    right_cells=$((right_px / cell_width))
    bottom_cells=$((bottom_px / cell_height))
else
    right_cells=$((window_width * 24 / 100))
    bottom_cells=$((window_height * 22 / 100))
fi

right_cells="$(clamp "$right_cells" 31 79)"
bottom_cells="$(clamp "$bottom_cells" 10 20)"

if (( window_width - right_cells < 80 )); then
    right_cells=$((window_width - 80))
fi
if (( right_cells < 20 )); then
    right_cells=$((window_width / 3))
fi

if (( window_height - bottom_cells < 18 )); then
    bottom_cells=$((window_height - 18))
fi
if (( bottom_cells < 6 )); then
    bottom_cells=$((window_height / 4))
fi

right_pane="$(tmux split-window -t "$main_pane" -h -l "$right_cells" -c "$CWD" -P -F '#{pane_id}')"
bottom_pane="$(tmux split-window -t "$main_pane" -v -l "$bottom_cells" -c "$CWD" -P -F '#{pane_id}')"

set_role "$main_pane" "main"
set_role "$right_pane" "right"
set_role "$bottom_pane" "bottom"

tmux select-pane -t "$main_pane"
