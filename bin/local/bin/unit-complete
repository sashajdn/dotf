#!/usr/bin/env bash
#
# unit-complete: Clean up a worktree after work is complete.
#
# Usage: unit-complete [-y|--yes] [ticket-name]
#   -y, --yes       Auto-confirm branch deletion (non-interactive)
#   -n, --no        Keep branch (non-interactive)
#   ticket-name     Required if not in a worktree
#
# Example: unit-complete
#          unit-complete -y GH-123
#          unit-complete --no GH-123

set -e

DOTF_AGENTS_WORKTREE_DIR="${DOTF_AGENTS_WORKTREE_DIR:-.agents}"
AUTO_DELETE=""

# Parse flags.
while [[ $# -gt 0 ]]; do
    case "$1" in
        -y|--yes)
            AUTO_DELETE="yes"
            shift
            ;;
        -n|--no)
            AUTO_DELETE="no"
            shift
            ;;
        *)
            TICKET="$1"
            shift
            ;;
    esac
done

# Determine ticket from argument or current directory.
CURRENT_PATH=$(pwd)
GIT_COMMON_DIR=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)

if [[ -z "$GIT_COMMON_DIR" ]]; then
    echo "Error: Not in a git repository" >&2
    exit 1
fi

MAIN_REPO=$(dirname "$GIT_COMMON_DIR")
REPO_NAME=$(basename "$MAIN_REPO" | tr '[:upper:]' '[:lower:]' | tr -cs '[:alnum:]-' '-' | sed 's/^-//;s/-$//')
WORKTREE_BASE="$MAIN_REPO/$DOTF_AGENTS_WORKTREE_DIR"

if [[ -n "$TICKET" ]]; then
    WORKTREE_PATH="$WORKTREE_BASE/$TICKET"
elif [[ "$CURRENT_PATH" == "$WORKTREE_BASE"/* ]]; then
    # We're inside a worktree.
    WORKTREE_PATH="$CURRENT_PATH"
    # Handle being in a subdirectory of the worktree.
    while [[ "$WORKTREE_PATH" != "$WORKTREE_BASE" ]] && [[ ! -f "$WORKTREE_PATH/.git" ]]; do
        WORKTREE_PATH=$(dirname "$WORKTREE_PATH")
    done
    TICKET="${WORKTREE_PATH#$WORKTREE_BASE/}"
else
    echo "Usage: unit-complete [-y|--yes] [-n|--no] [ticket-name]" >&2
    echo ""
    echo "Run from within a worktree, or provide ticket name" >&2
    exit 1
fi

if [[ ! -d "$WORKTREE_PATH" ]]; then
    echo "Error: Worktree not found at $WORKTREE_PATH" >&2
    exit 1
fi

# Get branch name before removal.
BRANCH=$(git -C "$WORKTREE_PATH" rev-parse --abbrev-ref HEAD 2>/dev/null || true)

echo "Completing unit: $TICKET"
echo "  Worktree: $WORKTREE_PATH"
echo "  Branch: $BRANCH"
echo ""

# Move out of worktree if we're in it.
if [[ "$CURRENT_PATH" == "$WORKTREE_PATH"* ]]; then
    builtin cd "$MAIN_REPO"
    echo "Changed directory to: $MAIN_REPO"
fi

# Remove the worktree.
echo "Removing worktree..."
git worktree remove "$WORKTREE_PATH"

# Handle branch deletion.
if [[ -n "$BRANCH" ]] && [[ "$BRANCH" != "HEAD" ]]; then
    if [[ "$AUTO_DELETE" == "yes" ]]; then
        git branch -d "$BRANCH" 2>/dev/null || git branch -D "$BRANCH"
        echo "Branch deleted"
    elif [[ "$AUTO_DELETE" == "no" ]]; then
        echo "Branch kept"
    else
        # Interactive mode.
        read -p "Delete branch '$BRANCH'? [y/N] " -n 1 -r
        echo
        if [[ $REPLY =~ ^[Yy]$ ]]; then
            git branch -d "$BRANCH" 2>/dev/null || git branch -D "$BRANCH"
            echo "Branch deleted"
        fi
    fi
fi

tmux-unit-close --session "$REPO_NAME" --ticket "$TICKET" --path "$WORKTREE_PATH" 2>/dev/null || true

echo ""
echo "Unit $TICKET completed and cleaned up"
