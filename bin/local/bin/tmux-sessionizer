#!/usr/bin/env bash

set -euo pipefail

DOTF_DIR="$HOME/dotf"
WIKI_DIR="$HOME/wiki"
REPOS_DIR="$HOME/repos"
WORK_DIR="$HOME/work"

# Thank you @ThePrimaegen
if [[ $# -eq 1 ]]; then
    selected=$1
else
    selected=$(
        {
            printf '%s\n' "$WIKI_DIR" "$DOTF_DIR"
            [[ -d "$REPOS_DIR" ]] && find "$REPOS_DIR" -mindepth 1 -maxdepth 1 -type d
            [[ -d "$WORK_DIR" ]] && find "$WORK_DIR" -mindepth 2 -maxdepth 2 -type d
        } | fzf
    )
fi

if [[ -z $selected ]]; then
    exit 0
fi

# Normalize name: lowercase, only alphanumeric and -, replace . and _ with -
selected_name=$(basename "$selected" | tr '[:upper:]' '[:lower:]' | tr -cs '[:alnum:]-' '-' | sed 's/^-//;s/-$//')
selected_window="$selected_name"

if ! tmux has-session -t="$selected_name" 2>/dev/null; then
    tmux new-session -ds "$selected_name" -c "$selected" -n "$selected_window"
    window_id="$(tmux display-message -p -t "$selected_name:$selected_window" '#{window_id}')"
    tmux set-option -w -t "$window_id" -q @unit_repo_root "$selected"
    tmux-unit-layout 3 --target "$window_id" --cwd "$selected" --title-prefix "$selected_name" --force
fi

if [[ -n "${TMUX:-}" ]]; then
    tmux switch-client -t "$selected_name" 2>/dev/null || true
    tmux select-window -t "$selected_name:$selected_window"
else
    tmux attach-session -t "$selected_name"
fi
